<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_widget_search"
        android:shortcutId="shortcut_search_cities"
        android:shortcutLongLabel="@string/shortcut_search_long"
        android:shortcutShortLabel="@string/shortcut_search_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.example.MainActivity"
            android:targetPackage="com.aistudio.weatherwidget.zavqpp">
            <extra
                android:name="extra_open_tab"
                android:value="cities" />
        </intent>
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_weather_partly_cloudy_day"
        android:shortcutId="shortcut_widget_studio"
        android:shortcutLongLabel="@string/shortcut_widgets_long"
        android:shortcutShortLabel="@string/shortcut_widgets_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.example.MainActivity"
            android:targetPackage="com.aistudio.weatherwidget.zavqpp">
            <extra
                android:name="extra_open_tab"
                android:value="widgets" />
        </intent>
    </shortcut>
</shortcuts>
